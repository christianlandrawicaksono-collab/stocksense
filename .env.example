# ==============================================================================
# StocksSense Market Data Configuration
# ==============================================================================
# Pilihan provider:
# - "illustrative" (DEFAULT: Menggunakan dataset fundamental & historis statis)
# - "yahoo"        (Menggunakan live data Yahoo Finance .JK, tertunda ~10 menit)
#
# Untuk mengaktifkan mode Yahoo Finance secara lokal:
# Salin berkas ini menjadi .env.local dan ubah nilainya menjadi "yahoo":
#   cp .env.example .env.local
#
MARKET_DATA_PROVIDER=illustrative
NEXT_PUBLIC_MARKET_DATA_PROVIDER=illustrative

# ==============================================================================
# Opsional: Konfigurasi Asisten AI Server-Side (/api/ai/analyze)
# ==============================================================================
# Jika dikosongkan, asisten AI akan menggunakan Analis Kontekstual Bawaan.
# Dapatkan API Key di Google AI Studio dan simpan di .env.local atau Vercel Secrets:
# GEMINI_API_KEY=your_google_ai_studio_api_key
# GEMINI_MODEL=gemini-3-flash-preview
